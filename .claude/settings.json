{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-build-while-filekin-runs.sh\"",
            "timeout": 20,
            "statusMessage": "Checking Filekin is closed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-before-stopping.sh\"",
            "timeout": 900,
            "statusMessage": "Running the Release validation block"
          }
        ]
      }
    ]
  }
}
