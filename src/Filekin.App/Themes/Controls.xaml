<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

  <BooleanToVisibilityConverter x:Key="BoolToVis" />

  <!-- ===== Text cells for the Files listing ===== -->
  <Style x:Key="CellType" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CellName" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="CellSlash" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CellMeta" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="HeaderCell" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== Sortable column header (click / Enter / Space to sort) ===== -->
  <Style x:Key="HeaderButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
              <Border x:Name="focusLine" Height="1.5" VerticalAlignment="Bottom" CornerRadius="1"
                      Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="focusLine" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== A column header's label + active-sort caret ===== -->
  <Style x:Key="HeaderCaret" TargetType="TextBlock" BasedOn="{StaticResource HeaderCell}">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <!-- ===== Path-bar segment (clickable location crumb) ===== -->
  <Style x:Key="PathSegmentButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="1,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Command-bar input (terminal-style, no chrome) ===== -->
  <Style x:Key="CommandInputBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentDimBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="AllowDrop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LocationEditorTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource MainBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <Style x:Key="LocationContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LocationContextMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Quiet icon action (e.g. open external terminal) ===== -->
  <Style x:Key="IconActionButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentDimBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Result-severity glyph coloring ===== -->
  <Style x:Key="ResultGlyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ResultSeverity}" Value="Success">
        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ResultSeverity}" Value="Error">
        <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Custom-chrome caption buttons ===== -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource ElevateBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CloseButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource BadBrush}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Quiet ghost button (View / Collapse) ===== -->
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource ElevateBrush}" />
              <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Sidebar nav item (Locations and /surfaces) ===== -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="9,4">
            <Grid>
              <Border Width="2.5" HorizontalAlignment="Left" Margin="-9,3,0,3" CornerRadius="2"
                      Background="{DynamicResource AccentBrush}"
                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
              <StackPanel Orientation="Horizontal">
                <!-- Sigil and name are one typeable token (@projects, /places), so they share the
                     command-bar font and size. Splitting them across two fonts read as a defect. -->
                <TextBlock Text="{Binding Symbol}" Width="14" TextAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonoFont}" FontSize="13.5">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SymbolAccent}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" Margin="1,0,0,0" VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonoFont}" FontSize="13.5"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Files listing row ===== -->
  <Style x:Key="FileRowItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,5">
            <Grid>
              <Border Width="2.5" HorizontalAlignment="Left" Margin="-3,3,0,3" CornerRadius="2"
                      Background="{DynamicResource AccentBrush}"
                      Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="148" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TypeCode}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellType}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource DirBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CellName}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DirBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="/" Style="{StaticResource CellSlash}"
                             Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Modified}" Style="{StaticResource CellMeta}" />
                <TextBlock Grid.Column="3" Text="{Binding Size}" Style="{StaticResource CellMeta}" HorizontalAlignment="Right" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Recycle Bin action-selection row (selection is local to the rich view, not @selection) ===== -->
  <Style x:Key="RecycleBinRowItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,5">
            <Grid>
              <Border x:Name="KeyboardFocusCue" BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="5" Margin="-4,-3" IsHitTestVisible="False" />
              <Border Width="2.5" HorizontalAlignment="Left" Margin="-3,3,0,3" CornerRadius="2"
                      Background="{DynamicResource AccentBrush}"
                      Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="230" />
                  <ColumnDefinition Width="132" />
                  <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TypeCode}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellType}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource DirBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CellName}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DirBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="/" Style="{StaticResource CellSlash}"
                             Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding OriginalLocation}" Style="{StaticResource CellMeta}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Deleted}" Style="{StaticResource CellMeta}" />
                <TextBlock Grid.Column="4" Text="{Binding Size}" Style="{StaticResource CellMeta}"
                           HorizontalAlignment="Right" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </MultiDataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="KeyboardFocusCue" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Places row: a navigation target, not a selectable filesystem entity ===== -->
  <Style x:Key="PlaceRowItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <StackPanel>
            <!-- The section caption belongs to the first row of each kind, so COMMON and CLOUD stay
                 grouped without a second collection or a stock GroupStyle header. -->
            <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource HeaderCell}" Margin="6,8,0,4"
                       Visibility="{Binding StartsSection, Converter={StaticResource BoolToVis}}" />
            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,7">
              <Grid>
                <Border x:Name="KeyboardFocusCue" BorderBrush="Transparent" BorderThickness="1"
                        CornerRadius="5" Margin="-4,-3" IsHitTestVisible="False" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CellName}" />
                  <TextBlock Grid.Column="2" Text="{Binding Path}" Style="{StaticResource CellMeta}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="KeyboardFocusCue" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Drives row: root, label, type, capacity, and a restrained usage bar ===== -->
  <Style x:Key="DriveRowItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,7">
            <Grid>
              <Border x:Name="KeyboardFocusCue" BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="5" Margin="-4,-3" IsHitTestVisible="False" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RootCell" Grid.Column="0" Text="{Binding Root}"
                           Style="{StaticResource CellName}" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource CellMeta}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding TypeText}" Style="{StaticResource CellType}" />
                <TextBlock x:Name="SpaceCell" Grid.Column="3" Text="{Binding SpaceText}"
                           Style="{StaticResource CellMeta}" />
                <!-- A thin two-layer bar, not a stock ProgressBar: capacity is context here, not a
                     task in progress. The fill is scaled rather than width-bound so it needs no
                     converter and no measured track width. -->
                <Grid Grid.Column="4" Height="4" Margin="0,0,6,0" VerticalAlignment="Center"
                      Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}">
                  <Border CornerRadius="2" Background="{DynamicResource LineBrush}" />
                  <Border CornerRadius="2" Background="{DynamicResource AccentBrush}"
                          RenderTransformOrigin="0,0">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleX="{Binding UsageFraction}" />
                    </Border.RenderTransform>
                  </Border>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <!-- An assigned but unreachable drive stays visible and readable, but never navigates. -->
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
              <Setter TargetName="Row" Property="Opacity" Value="0.55" />
              <Setter TargetName="Row" Property="Cursor" Value="Arrow" />
              <Setter TargetName="SpaceCell" Property="Foreground" Value="{DynamicResource WarnBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                <Condition Binding="{Binding IsAvailable}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </MultiDataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="KeyboardFocusCue" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Settings category rail: a button list, so it uses the UI font ===== -->
  <Style x:Key="SettingsCategoryItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,7">
            <Grid>
              <Border x:Name="ActiveBar" Width="2.5" HorizontalAlignment="Left" Margin="-10,1,0,1"
                      CornerRadius="2" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
              <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13"
                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
              <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
              <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextBrush}" />
              <Setter TargetName="Title" Property="FontWeight" Value="Medium" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== One choice in a settings group: mark, optional swatch, title, quiet detail ===== -->
  <Style x:Key="SettingsOptionItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,7">
            <Grid>
              <Border x:Name="KeyboardFocusCue" BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="5" Margin="-4,-3" IsHitTestVisible="False" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- A radio group drawn in the command-bar font rather than a stock RadioButton, so
                     the mark sits on the same grid as every other cell in the app. -->
                <TextBlock x:Name="Mark" Grid.Column="0" Text="{Binding Marker}"
                           FontFamily="{DynamicResource MonoFont}" FontSize="12"
                           Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="13" Height="13" CornerRadius="3" Margin="0,0,9,0"
                        VerticalAlignment="Center" Background="{Binding Swatch}"
                        BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                        Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="2" Text="{Binding Title}" Style="{StaticResource CellName}" />
                <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource CellMeta}"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="KeyboardFocusCue" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== One interactive-program rule: name, origin, and Remove for user-added rules ===== -->
  <Style x:Key="ProgramRowItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,5">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NameCell" Grid.Column="0" Text="{Binding Name}"
                         Style="{StaticResource CellName}" />
              <TextBlock Grid.Column="1" Text="{Binding Origin}" Style="{StaticResource CellType}" />
              <!-- No Click here: this dictionary has no code-behind, so the owning ListBox handles
                   the bubbled Button.Click and reads the row from the button's DataContext. -->
              <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                      Width="24" Height="24" Style="{StaticResource IconActionButton}"
                      ToolTip="Remove this rule"
                      AutomationProperties.Name="Remove this interactive program"
                      Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <!-- A built-in rule is shown so the user can see what is already covered, but it is
                 not an editable row and must not read like one. -->
            <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
              <Setter TargetName="NameCell" Property="Foreground" Value="{DynamicResource MutedBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Group caption inside a settings panel ===== -->
  <Style x:Key="SettingsGroupCaption" TargetType="TextBlock" BasedOn="{StaticResource HeaderCell}">
    <Setter Property="Margin" Value="6,14,0,4" />
  </Style>

  <!-- ===== Chromeless ListBox ===== -->
  <Style x:Key="PlainListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- ===== Slim scrollbar (replaces stock chrome) ===== -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="11" />
    <Setter Property="MinWidth" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
              <Track.Thumb>
                <Thumb Focusable="False">
                  <Thumb.Style>
                    <Style TargetType="Thumb">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Thumb">
                            <Border Background="{DynamicResource LineStrongBrush}" CornerRadius="5" Margin="3,2" />
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Thumb.Style>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Height" Value="11" />
              <Setter Property="MinWidth" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
