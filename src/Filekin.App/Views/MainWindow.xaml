<Window x:Class="Filekin.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Filekin.App.Controls"
        Title="Filekin" Height="720" Width="1120" MinHeight="560" MinWidth="880"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Loaded="OnLoaded"
        Activated="OnWindowActivated"
        PreviewKeyDown="OnPreviewKeyDown">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0"
                  GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" Background="{DynamicResource WindowBrush}"
          BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>

      <!-- ================= TITLE BAR + TABS ================= -->
      <Grid Grid.Row="0" Background="{DynamicResource PanelBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="248" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
            <TextBlock Text="&#x259A;" FontFamily="{DynamicResource MonoFont}" FontSize="13"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="FILEKIN" FontWeight="SemiBold" FontSize="12.5" Margin="9,0,0,0"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,8,0">
            <Border Height="35" CornerRadius="8,8,0,0" Margin="0,0,2,-1"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,0"
                    MouseLeftButtonDown="OnFilesTabSelected" AutomationProperties.Name="Files tab">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFilesWorkspaceSelected}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Border Height="2" VerticalAlignment="Top" CornerRadius="1,1,0,0"
                        Background="{DynamicResource AccentBrush}"
                        Visibility="{Binding IsFilesWorkspaceSelected, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                  <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Files" Margin="8,0,0,0" FontSize="13" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding TerminalTabs}" Margin="4,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="35" CornerRadius="8,8,0,0" Margin="0,0,2,-1"
                          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,0"
                          MouseLeftButtonDown="OnTerminalTabSelected" AutomationProperties.Name="{Binding Title}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Border Height="2" VerticalAlignment="Top" CornerRadius="1,1,0,0"
                              Background="{DynamicResource AccentBrush}"
                              Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="7,0,0,0"
                                Style="{StaticResource IconActionButton}" Width="24" Height="24"
                                Click="OnCloseTerminalTab" AutomationProperties.Name="Close terminal tab" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="&#xE710;" FontSize="11" Width="32" Height="32" Margin="2,1,0,1"
                    Style="{StaticResource IconActionButton}" Click="OnNewTerminalTab"
                    ToolTip="New PowerShell terminal" AutomationProperties.Name="New PowerShell terminal" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" Content="&#xE921;"
                  AutomationProperties.Name="Minimize" />
          <Button Style="{StaticResource CaptionButton}" Click="OnMaxRestore" AutomationProperties.Name="Maximize or restore">
            <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
          </Button>
          <Button Style="{StaticResource CloseButton}" Click="OnClose" Content="&#xE8BB;"
                  AutomationProperties.Name="Close" />
        </StackPanel>
      </Grid>

      <!-- ================= BODY ================= -->
      <Grid Grid.Row="1" Visibility="{Binding IsFilesWorkspaceSelected, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="248" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
          <DockPanel Margin="12,14">
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                    Margin="6,8,6,0" Padding="0,8,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,10,0" Padding="4,2" Click="OnOpenSettings"
                        Style="{StaticResource PathSegmentButton}"
                        AutomationProperties.Name="Settings">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Text="Settings" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}"
                             FontSize="12.5" VerticalAlignment="Center" />
                  <TextBlock Text="About" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                             Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid DockPanel.Dock="Top" Margin="8,4,8,8">
              <TextBlock Text="LOCATIONS" FontFamily="{DynamicResource MonoFont}" FontSize="10.5"
                         Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="24" Height="24"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconActionButton}"
                      Click="OnAddLocation" AutomationProperties.Name="Add Location" />
            </Grid>

            <Border DockPanel.Dock="Top" Margin="4,0,4,10" Padding="9" CornerRadius="7"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Background="{DynamicResource MainBrush}"
                    Visibility="{Binding IsLocationEditorOpen, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="{Binding LocationEditorTitle}" FontFamily="{DynamicResource MonoFont}"
                           FontSize="10.5" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,7" />
                <TextBlock Text="Name" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,3" />
                <TextBox x:Name="LocationNameBox" Text="{Binding LocationEditorName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LocationEditorTextBox}" AutomationProperties.Name="Location name"
                         KeyDown="OnLocationEditorKeyDown" />
                <TextBlock Text="Path" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,3" />
                <TextBox x:Name="LocationPathBox" Text="{Binding LocationEditorPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LocationEditorTextBox}" AutomationProperties.Name="Location path"
                         KeyDown="OnLocationEditorKeyDown" />
                <TextBlock Text="{Binding LocationEditorError}" Foreground="{DynamicResource BadBrush}"
                           TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Save" Click="OnSaveLocation" Style="{StaticResource GhostButton}"
                          Margin="0,0,6,0" AutomationProperties.Name="Save Location" />
                  <Button Content="Cancel" Click="OnCancelLocation" Style="{StaticResource GhostButton}"
                          Margin="0,0,6,0" />
                  <Button Content="Remove" Click="OnRemoveEditedLocation" Style="{StaticResource GhostButton}"
                          Visibility="{Binding CanRemoveEditedLocation, Converter={StaticResource BoolToVis}}"
                          ToolTip="Removes the saved Location, not the folder" />
                </StackPanel>
              </StackPanel>
            </Border>

            <ListBox DockPanel.Dock="Bottom" Style="{StaticResource PlainListBox}"
                     ItemsSource="{Binding Surfaces}" ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="OnSurfaceSelected" />

            <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource LineBrush}" Margin="8,12" />

            <ListBox x:Name="LocationsList" Style="{StaticResource PlainListBox}"
                     ItemsSource="{Binding Locations}" ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="OnLocationSelected" ContextMenuOpening="OnLocationContextMenuOpening">
              <ListBox.ContextMenu>
                <ContextMenu Style="{StaticResource LocationContextMenu}">
                  <MenuItem Header="Edit Location…" Click="OnEditContextLocation"
                            Style="{StaticResource LocationContextMenuItem}" />
                  <MenuItem Header="Remove Location" Click="OnRemoveContextLocation"
                            Style="{StaticResource LocationContextMenuItem}" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- MAIN -->
        <DockPanel Grid.Column="1" Background="{DynamicResource MainBrush}">

          <Grid DockPanel.Dock="Top" Margin="18,12,18,10"
                Visibility="{Binding IsFilesContentVisible, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding PathSegments}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="\" FontFamily="{DynamicResource MonoFont}" FontSize="13.5"
                               Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"
                               Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PathSegmentButton}" Click="OnPathSegmentClick" Tag="{Binding FullPath}"
                            IsEnabled="{Binding DataContext.IsFilesContentVisible, RelativeSource={RelativeSource AncestorType=Window}}">
                      <TextBlock Text="{Binding Text}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsLast}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="Medium" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Style="{StaticResource IconActionButton}" Content="&#xE756;" Click="OnOpenExternalTerminal"
                      ToolTip="Open an external terminal here" AutomationProperties.Name="Open an external terminal here"
                      Margin="0,0,14,0" />
              <TextBlock Text="{Binding ItemCount}" VerticalAlignment="Center"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource FaintBrush}" />
            </StackPanel>
          </Grid>

          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1"
                  Margin="18,0" Padding="6,7"
                  Visibility="{Binding IsFilesContentVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="148" />
                <ColumnDefinition Width="74" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Style="{StaticResource HeaderButton}" Tag="Type" Click="OnHeaderClick"
                      AutomationProperties.Name="Sort by type">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="TYPE" Style="{StaticResource HeaderCell}" />
                  <TextBlock Text="{Binding TypeCaret}" Style="{StaticResource HeaderCaret}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="Name" Click="OnHeaderClick"
                      AutomationProperties.Name="Sort by name">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="NAME" Style="{StaticResource HeaderCell}" />
                  <TextBlock Text="{Binding NameCaret}" Style="{StaticResource HeaderCaret}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="Modified" Click="OnHeaderClick"
                      AutomationProperties.Name="Sort by modified date">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="MODIFIED" Style="{StaticResource HeaderCell}" />
                  <TextBlock Text="{Binding ModifiedCaret}" Style="{StaticResource HeaderCaret}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="Size" Click="OnHeaderClick"
                      HorizontalContentAlignment="Right" AutomationProperties.Name="Sort by size">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="SIZE" Style="{StaticResource HeaderCell}" />
                  <TextBlock Text="{Binding SizeCaret}" Style="{StaticResource HeaderCaret}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- command zone -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                  Background="{DynamicResource MainBrush}">
            <StackPanel>
              <DockPanel Margin="18,12">
                <TextBlock DockPanel.Dock="Left" Text="{Binding PromptPath}" VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonoFont}" FontSize="13.5" Foreground="{DynamicResource FaintBrush}" />
                <TextBlock DockPanel.Dock="Left" Text="  &#x203A;  " VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonoFont}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBox x:Name="CommandBox" Style="{StaticResource CommandInputBox}"
                         Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnCommandPreviewKeyDown"
                         TextChanged="OnCommandTextChanged"
                         LostKeyboardFocus="OnCommandLostKeyboardFocus" />
              </DockPanel>

              <Popup IsOpen="{Binding IsCommandSuggestionsOpen, Mode=OneWay}" PlacementTarget="{Binding ElementName=CommandBox}"
                     Placement="Top" VerticalOffset="-4" AllowsTransparency="True" StaysOpen="True"
                     Focusable="False">
                <Border Width="{Binding ActualWidth, ElementName=CommandBox}" MinWidth="480" MaxWidth="720"
                        MaxHeight="238" Padding="5" CornerRadius="7"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineStrongBrush}"
                        BorderThickness="1">
                  <ListBox x:Name="CommandSuggestionList"
                           ItemsSource="{Binding CommandSuggestions}"
                           SelectedIndex="{Binding SelectedCommandSuggestionIndex, Mode=TwoWay}"
                           Style="{StaticResource CommandSuggestionList}"
                           ItemContainerStyle="{StaticResource CommandSuggestionItem}"
                           PreviewMouseLeftButtonDown="OnCommandSuggestionMouseDown"
                           AutomationProperties.Name="Command suggestions">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Text}" FontFamily="{DynamicResource MonoFont}"
                                     FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Description}" FontFamily="{DynamicResource UiFont}"
                                     FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </Popup>

              <!-- In-app "are you sure?" — answered with Y/N, never an OS dialog -->
              <Border BorderBrush="{DynamicResource WarnBrush}" BorderThickness="0,1,0,0"
                      Background="{DynamicResource ElevateBrush}"
                      Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                <Grid Margin="18,10">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConfirmPrompt}" Foreground="{DynamicResource TextBrush}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="13" Margin="10,0,24,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Y · Yes" Click="OnConfirmYes" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            AutomationProperties.Name="Confirm yes" />
                    <Button Content="N · No" Click="OnConfirmNo" Style="{StaticResource GhostButton}"
                            AutomationProperties.Name="Cancel" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- A running archive is a workspace task, not a modal sheet. Back/Esc may dismiss
                   its rich view while this strip keeps the operation visible and controllable. -->
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                      Background="{DynamicResource ElevateBrush}"
                      Visibility="{Binding IsArchiveBusy, Converter={StaticResource BoolToVis}}">
                <Grid Margin="18,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="…" Style="{StaticResource ResultGlyph}" />
                    <TextBlock Grid.Column="1" Text="{Binding ArchiveTitle}" Margin="10,0,12,0"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ArchiveProgressText}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="View" Click="OnViewArchiveProgress" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Visibility="{Binding CanViewArchiveProgress, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="View archive progress" />
                    <Button Content="Stop" Click="OnStopArchive" Style="{StaticResource GhostButton}"
                            AutomationProperties.Name="Stop archive operation" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- A running tidy is a workspace task too, on the same terms as an archive: Back/Esc
                   may dismiss the plan while this strip keeps the move visible and stoppable. -->
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                      Background="{DynamicResource ElevateBrush}"
                      Visibility="{Binding IsTidyBusy, Converter={StaticResource BoolToVis}}">
                <Grid Margin="18,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="…" Style="{StaticResource ResultGlyph}" />
                    <TextBlock Grid.Column="1" Text="{Binding TidyTitle}" Margin="10,0,12,0"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding TidyProgressText}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="View" Click="OnViewTidyProgress" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Visibility="{Binding CanViewTidyProgress, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="View tidy progress" />
                    <Button Content="Stop" Click="OnStopTidy" Style="{StaticResource GhostButton}"
                            AutomationProperties.Name="Stop tidy" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                      Visibility="{Binding ResultVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="18,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding ResultGlyph}" Style="{StaticResource ResultGlyph}" />
                    <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource MutedBrush}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="13" Margin="10,0,12,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                              VerticalAlignment="Top">
                    <Button Content="Undo" Click="OnUndoArchive" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Visibility="{Binding CanShowArchiveUndo, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Undo archive operation"
                            AutomationProperties.HelpText="{Binding ArchiveUndoLabel}" />
                    <Button x:Name="ViewButton" Content="View" Click="OnToggleOutput"
                            Style="{StaticResource GhostButton}"
                            Visibility="{Binding HasExpandableOutput, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border x:Name="OutputPanel" Visibility="Collapsed" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="0,1,0,0" Padding="18,10" MaxHeight="260">
                <!-- A read-only TextBox, not a TextBlock: command output has to be selectable so it
                     can be copied, and it brings its own scrollbar for long output. -->
                <TextBox Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                         Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                         SelectionBrush="{DynamicResource AccentDimBrush}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Command output" />
              </Border>
            </StackPanel>
          </Border>

          <!-- main surface: the Files hierarchy, or one of the temporary rich views over it -->
          <Grid>
            <ListBox x:Name="FilesList" Margin="12,6"
                     Style="{StaticResource PlainListBox}"
                     Visibility="{Binding IsFilesContentVisible, Converter={StaticResource BoolToVis}}"
                     ItemsSource="{Binding Files}" ItemContainerStyle="{StaticResource FileRowItem}"
                     SelectionMode="Extended"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="OnFilesSelectionChanged"
                     MouseDoubleClick="OnFilesActivate"
                     PreviewKeyDown="OnFilesPreviewKeyDown" />

            <!-- Recycle Bin (Files · Recycle Bin) -->
            <DockPanel Margin="12,6" Visibility="{Binding IsRecycleBinOpen, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="6,2,6,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Recycle Bin" Margin="10,0,0,0" FontSize="14" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding RecycleBinStatus}" Margin="12,0,0,0" FontFamily="{DynamicResource MonoFont}"
                             FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Restore" Click="OnRestoreRecycledSelection" Style="{StaticResource GhostButton}"
                          IsEnabled="{Binding HasSelectedRecycledItems}" Margin="0,0,8,0"
                          AutomationProperties.Name="Restore selected Recycle Bin items" />
                  <Button Content="Delete forever" Click="OnDeleteRecycledSelection" Style="{StaticResource GhostButton}"
                          IsEnabled="{Binding HasSelectedRecycledItems}" Margin="0,0,8,0"
                          AutomationProperties.Name="Permanently delete selected Recycle Bin items" />
                  <Button Click="OnEmptyRecycleBin" Style="{StaticResource GhostButton}"
                          IsEnabled="{Binding HasRecycledItems}" Margin="0,0,8,0"
                          ToolTip="Permanently delete everything in the Recycle Bin"
                          AutomationProperties.Name="Empty Recycle Bin">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="Empty" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Content="Back" Click="OnCloseRecycleBin" Style="{StaticResource GhostButton}" />
                </StackPanel>
              </Grid>

              <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1"
                      Margin="6,0" Padding="6,7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="TYPE" Style="{StaticResource HeaderCell}" />
                  <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource HeaderCell}" />
                  <TextBlock Grid.Column="2" Text="FROM" Style="{StaticResource HeaderCell}" />
                  <TextBlock Grid.Column="3" Text="DELETED" Style="{StaticResource HeaderCell}" />
                  <TextBlock Grid.Column="4" Text="SIZE" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                </Grid>
              </Border>

              <ListBox x:Name="RecycleBinList" ItemsSource="{Binding RecycledItems}" Margin="6,4"
                       Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource RecycleBinRowItem}"
                       SelectionMode="Extended" SelectionChanged="OnRecycleBinSelectionChanged"
                       PreviewKeyDown="OnRecycleBinPreviewKeyDown" MouseMove="OnRecycleBinMouseMove"
                       PreviewMouseDown="OnRecycleBinPreviewMouseDown" Tag="True"
                       AutomationProperties.HelpText="Click or Arrow selects one item. Shift extends the selection. Ctrl moves focus or toggles an item with Space."
                       VirtualizingStackPanel.IsVirtualizing="True"
                       VirtualizingStackPanel.VirtualizationMode="Recycling"
                       ScrollViewer.CanContentScroll="True" />
            </DockPanel>

            <!-- Places (Files · Places) -->
            <DockPanel Margin="12,6" Visibility="{Binding IsPlacesOpen, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="6,2,6,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Places" Margin="10,0,0,0" FontSize="14" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PlacesStatus}" Margin="12,0,0,0" FontFamily="{DynamicResource MonoFont}"
                             FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Back" Click="OnClosePlaces" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" />
              </Grid>

              <!-- One click navigates: these rows are destinations, not a file selection. -->
              <ListBox x:Name="PlacesList" ItemsSource="{Binding Places}" Margin="6,4"
                       Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource PlaceRowItem}"
                       SelectionMode="Single" PreviewMouseLeftButtonUp="OnPlaceClicked"
                       PreviewKeyDown="OnPlacesPreviewKeyDown"
                       AutomationProperties.Name="Places"
                       AutomationProperties.HelpText="Click a row or press Enter to go there." />
            </DockPanel>

            <!-- Drives (Files · Drives) -->
            <DockPanel Margin="12,6" Visibility="{Binding IsDrivesOpen, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="6,2,6,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Drives" Margin="10,0,0,0" FontSize="14" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DrivesStatus}" Margin="12,0,0,0" FontFamily="{DynamicResource MonoFont}"
                             FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Back" Click="OnCloseDrives" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" />
              </Grid>

              <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1"
                      Margin="6,0" Padding="6,7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="ROOT" Style="{StaticResource HeaderCell}" />
                  <TextBlock Grid.Column="1" Text="LABEL" Style="{StaticResource HeaderCell}" />
                  <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource HeaderCell}" />
                  <TextBlock Grid.Column="3" Text="SPACE" Style="{StaticResource HeaderCell}" />
                </Grid>
              </Border>

              <ListBox x:Name="DrivesList" ItemsSource="{Binding Drives}" Margin="6,4"
                       Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource DriveRowItem}"
                       SelectionMode="Single" PreviewMouseLeftButtonUp="OnDriveClicked"
                       PreviewKeyDown="OnDrivesPreviewKeyDown"
                       AutomationProperties.Name="Drives"
                       AutomationProperties.HelpText="Click a row or press Enter to open that drive. Unavailable drives cannot be opened." />
            </DockPanel>

            <!-- Where (Files · Where — query): progressive discovery with explicit actions. -->
            <DockPanel Margin="12,6" Visibility="{Binding IsWhereOpen, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="6,2,6,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding WhereTitle}" Margin="10,0,0,0" FontSize="14" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding WhereStatus}" Margin="12,0,0,0" FontFamily="{DynamicResource MonoFont}"
                             FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Stop" Click="OnStopWhere" Style="{StaticResource GhostButton}"
                          Margin="0,0,8,0"
                          Visibility="{Binding IsWhereScanning, Converter={StaticResource BoolToVis}}" />
                  <Button Content="Back" Click="OnCloseWhere" Style="{StaticResource GhostButton}" />
                </StackPanel>
              </Grid>

              <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                      Margin="6,6,6,0" Padding="6,8,6,2"
                      Visibility="{Binding HasWhereNotice, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding WhereNotice}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Button Content="Undo" Click="OnUndoUserPath" Style="{StaticResource GhostButton}"
                          Margin="12,0,0,0"
                          Visibility="{Binding CanUndoUserPathChange, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </Border>

              <ListBox x:Name="WhereList" ItemsSource="{Binding WhereItems}" Margin="6,0"
                       Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource WhereRowItem}"
                       SelectionMode="Single" Button.Click="OnWhereRowAction"
                       AutomationProperties.Name="Where results"
                       AutomationProperties.HelpText="Program locations. Use Go to, Open, or Add to PATH." />
            </DockPanel>

            <!-- Info (Files · Info) — a rich view like the others, but a field sheet rather than a
                 listing: it describes one thing instead of offering a list to choose from. -->
            <DockPanel Margin="12,6" Visibility="{Binding IsInfoOpen, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="6,2,6,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Info" Margin="10,0,0,0" FontSize="14" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding InfoStatus}" Margin="12,0,0,0" FontFamily="{DynamicResource MonoFont}"
                             FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Back" Click="OnCloseInfo" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" />
              </Grid>

              <TextBlock DockPanel.Dock="Top" Text="{Binding InfoHeading}" Margin="12,6,12,10"
                         FontFamily="{DynamicResource MonoFont}" FontSize="15"
                         Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />

              <!-- The escape hatch sits at the foot of the sheet: Filekin answers the everyday
                   questions, Windows owns permissions, signatures, and compatibility. -->
              <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                      Margin="6,6,6,0" Padding="6,8,6,2"
                      Visibility="{Binding CanOpenWindowsProperties, Converter={StaticResource BoolToVis}}">
                <Button Content="Windows Properties" Click="OnOpenWindowsProperties"
                        Style="{StaticResource GhostButton}" HorizontalAlignment="Left" />
              </Border>

              <ListBox x:Name="InfoList" ItemsSource="{Binding InfoRows}" Margin="6,0"
                       Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource InfoFieldRow}"
                       SelectionMode="Single" PreviewKeyDown="OnInfoPreviewKeyDown"
                       Button.Click="OnInfoRowActionClicked"
                       AutomationProperties.Name="Info"
                       AutomationProperties.HelpText="Details for the inspected item. Some rows offer an action." />
            </DockPanel>

            <!-- Archive (Files - Extract / Create) - one preview shared by /unzip and /zip. Both ask
                 the same question, "here is what I am about to write, is that right?", so answering
                 it in two shapes would teach two things where one will do. The controls re-plan
                 rather than edit the plan, so the list is always what will actually be written. -->
            <DockPanel Margin="12,6" Visibility="{Binding IsArchiveOpen, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="6,2,6,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xF12B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ArchiveTitle}" Margin="10,0,0,0" FontSize="14" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ArchiveSummary}" Margin="12,0,0,0"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12"
                             Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Back" Click="OnCloseArchive" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" />
              </Grid>

              <!-- Where it lands, spelled out. The one thing worth reading before pressing Enter. -->
              <TextBlock DockPanel.Dock="Top" Text="{Binding ArchiveDestination}" Margin="12,6,12,8"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                         Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />

              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,8">
                <CheckBox Content="Into a folder" IsChecked="{Binding ArchiveIntoFolder, Mode=TwoWay}"
                          Style="{StaticResource ArchiveToggle}" IsEnabled="{Binding CanRunArchive}"
                          AutomationProperties.HelpText="Off puts the contents straight into the destination." />
                <TextBox Text="{Binding ArchiveFolderName, Mode=TwoWay}" Width="190" Margin="0,0,18,0"
                         Style="{StaticResource LocationEditorTextBox}"
                         IsEnabled="{Binding CanEditArchiveFolderName}"
                         AutomationProperties.Name="Folder name" />
                <CheckBox Content="Replace existing files" IsChecked="{Binding ArchiveOverwrite, Mode=TwoWay}"
                          Style="{StaticResource ArchiveToggle}" IsEnabled="{Binding CanRunArchive}"
                          AutomationProperties.HelpText="Replaced files go to the Recycle Bin, so this can be undone." />
              </StackPanel>

              <TextBlock DockPanel.Dock="Top" Text="{Binding ArchiveWarning}" Margin="12,0,12,8"
                         Visibility="{Binding HasArchiveWarning, Converter={StaticResource BoolToVis}}"
                         Foreground="{DynamicResource WarnBrush}" FontSize="11.5" TextWrapping="Wrap" />

              <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                      Margin="6,6,6,0" Padding="6,8,6,2">
                <StackPanel Orientation="Horizontal">
                  <Button Content="{Binding ArchiveActionLabel}" Click="OnRunArchive"
                          Style="{StaticResource GhostButton}" IsEnabled="{Binding CanRunArchive}" />
                  <Button Content="{Binding ArchiveSecondaryActionLabel}" Click="OnArchiveSecondaryAction"
                          Style="{StaticResource GhostButton}"
                          Margin="8,0,0,0" />
                  <CheckBox Content="Don&apos;t show this again"
                            IsChecked="{Binding ArchiveHidePreviewNextTime, Mode=TwoWay}"
                            Style="{StaticResource ArchiveToggle}" Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanRunArchive, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Don&apos;t show this again"
                            AutomationProperties.HelpText="Turns off the archive preview for future runs. Settings, Archives turns it back on." />
                  <TextBlock Text="{Binding ArchiveProgressText}" Margin="16,0,0,0"
                             FontFamily="{DynamicResource MonoFont}" FontSize="11"
                             Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <ListBox ItemsSource="{Binding ArchiveRows}" Margin="6,0"
                       Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource ArchiveRowItem}"
                       SelectionMode="Single"
                       AutomationProperties.Name="Archive contents"
                       AutomationProperties.HelpText="What this command will write. Rows in the warning colour will not be written." />
            </DockPanel>

            <!-- Tidy (Files · Tidy) — the plan, before anything moves. Category ticks only:
                 the owner confirmed the plan chooses folders, never single files. -->
            <DockPanel Margin="12,6" Visibility="{Binding IsTidyOpen, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="6,2,6,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding TidyTitle}" Margin="10,0,0,0" FontSize="14" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding TidySummary}" Margin="12,0,0,0"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12"
                             Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Back" Click="OnCloseTidy" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" />
              </Grid>

              <TextBlock DockPanel.Dock="Top" Text="{Binding TidyFolderPath}" Margin="12,6,12,8"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                         Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />

              <TextBlock DockPanel.Dock="Top" Margin="12,0,12,8" FontSize="11.5" TextWrapping="Wrap"
                         Visibility="{Binding HasTidySkipped, Converter={StaticResource BoolToVis}}"
                         Foreground="{DynamicResource FaintBrush}">
                <Run Text="Staying put: " />
                <Run Text="{Binding TidySkippedText, Mode=OneWay}" />
              </TextBlock>

              <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                      Margin="6,6,6,0" Padding="6,8,6,2">
                <StackPanel Orientation="Horizontal">
                  <Button Content="Tidy" Click="OnRunTidy" Style="{StaticResource GhostButton}"
                          IsEnabled="{Binding CanStartTidy}"
                          Visibility="{Binding IsTidyPlanEditable, Converter={StaticResource BoolToVis}}" />
                  <Button Content="{Binding TidySecondaryActionLabel}" Click="OnTidySecondaryAction"
                          Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                  <CheckBox Content="Don&apos;t show this again"
                            IsChecked="{Binding TidyHidePreviewNextTime, Mode=TwoWay}"
                            Style="{StaticResource ArchiveToggle}" Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsTidyPlanEditable, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Don&apos;t show this again"
                            AutomationProperties.HelpText="Turns off the Tidy plan for future runs. Settings, Tidy turns it back on." />
                  <TextBlock Text="{Binding TidyProgressText}" Margin="16,0,0,0"
                             FontFamily="{DynamicResource MonoFont}" FontSize="11"
                             Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <ListBox ItemsSource="{Binding TidyGroups}" Margin="6,0"
                       Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource TidyRowItem}"
                       SelectionMode="Single"
                       AutomationProperties.Name="Tidy plan"
                       AutomationProperties.HelpText="One row per category. Untick a row to leave those files where they are." />
            </DockPanel>

            <!-- Settings (Files · Settings) — a rich view like the others: the Files location,
                 selection, and @selection underneath are preserved, and Esc or Back returns. -->
            <DockPanel Margin="12,6" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="6,2,6,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Settings" Margin="10,0,0,0" FontSize="14" FontWeight="Medium"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SettingsStatus}" Margin="12,0,0,0" FontFamily="{DynamicResource MonoFont}"
                             FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Back" Click="OnCloseSettings" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" />
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="176" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"
                        Padding="6,0,12,0">
                  <ListBox x:Name="SettingsCategoryList" ItemsSource="{Binding SettingsCategories}"
                           Style="{StaticResource PlainListBox}"
                           ItemContainerStyle="{StaticResource SettingsCategoryItem}"
                           SelectionMode="Single" SelectedIndex="0"
                           SelectionChanged="OnSettingsCategorySelected"
                           AutomationProperties.Name="Settings categories" />
                </Border>

                <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Text="{Binding SettingsCategoryTitle}" FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}" Margin="6,0,0,2" />
                    <TextBlock Text="{Binding SettingsCategorySummary}" FontSize="12.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,2" TextWrapping="Wrap" />

                    <!-- Appearance -->
                    <StackPanel Visibility="{Binding IsAppearanceCategory, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="THEME" Style="{StaticResource SettingsGroupCaption}" />
                      <ListBox x:Name="ThemeOptionList" ItemsSource="{Binding ThemeOptions}"
                               Style="{StaticResource PlainListBox}"
                               ItemContainerStyle="{StaticResource SettingsOptionItem}"
                               SelectionMode="Single" PreviewMouseLeftButtonUp="OnThemeOptionClicked"
                               PreviewKeyDown="OnThemeOptionKeyDown"
                               AutomationProperties.Name="Theme"
                               AutomationProperties.HelpText="Click a row or press Enter to use that theme." />

                      <TextBlock Text="ACCENT" Style="{StaticResource SettingsGroupCaption}" />
                      <ListBox x:Name="AccentOptionList" ItemsSource="{Binding AccentOptions}"
                               Style="{StaticResource PlainListBox}"
                               ItemContainerStyle="{StaticResource SettingsOptionItem}"
                               SelectionMode="Single" PreviewMouseLeftButtonUp="OnAccentOptionClicked"
                               PreviewKeyDown="OnAccentOptionKeyDown"
                               AutomationProperties.Name="Accent colour"
                               AutomationProperties.HelpText="Click a row or press Enter to use that accent colour." />
                    </StackPanel>

                    <!-- Startup -->
                    <StackPanel Visibility="{Binding IsStartupCategory, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="OPEN FILES AT LAUNCH" Style="{StaticResource SettingsGroupCaption}" />
                      <ListBox x:Name="StartupOptionList" ItemsSource="{Binding StartupOptions}"
                               Style="{StaticResource PlainListBox}"
                               ItemContainerStyle="{StaticResource SettingsOptionItem}"
                               SelectionMode="Single" PreviewMouseLeftButtonUp="OnStartupOptionClicked"
                               PreviewKeyDown="OnStartupOptionKeyDown"
                               AutomationProperties.Name="Open Files at launch"
                               AutomationProperties.HelpText="Click a row or press Enter to open Files there at launch." />
                      <TextBlock Margin="6,10,0,0" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource FaintBrush}"
                                 Text="Choosing a saved Location follows it if its path changes later. Filekin opens Home for one launch when the target is unavailable, and keeps the setting. This never changes your PowerShell profile." />
                    </StackPanel>

                    <!-- Terminal -->
                    <StackPanel Visibility="{Binding IsTerminalCategory, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="INTERACTIVE PROGRAMS" Style="{StaticResource SettingsGroupCaption}" />
                      <DockPanel Margin="6,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Add" Click="OnAddInteractiveProgram"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                AutomationProperties.Name="Add interactive program" />
                        <TextBox x:Name="NewProgramBox"
                                 Text="{Binding NewProgramName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LocationEditorTextBox}"
                                 KeyDown="OnNewProgramKeyDown"
                                 AutomationProperties.Name="Program name"
                                 AutomationProperties.HelpText="A program name such as vim or htop." />
                      </DockPanel>
                      <ListBox x:Name="ProgramList" ItemsSource="{Binding InteractiveProgramRows}"
                               Style="{StaticResource PlainListBox}"
                               ItemContainerStyle="{StaticResource ProgramRowItem}"
                               Button.Click="OnRemoveInteractiveProgram"
                               AutomationProperties.Name="Interactive programs" />
                      <TextBlock Margin="6,10,0,0" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource FaintBrush}"
                                 Text="These programs open in a terminal tab instead of running as a single command. Built-in rules cannot be removed." />
                    </StackPanel>

                    <!-- Archives -->
                    <StackPanel Visibility="{Binding IsArchivesCategory, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="BEFORE WRITING" Style="{StaticResource SettingsGroupCaption}" />
                      <CheckBox Content="Show a preview before extracting or creating"
                                IsChecked="{Binding PreviewArchives, Mode=OneWay}"
                                Click="OnArchivePreviewSettingClicked"
                                Style="{StaticResource ArchiveToggle}"
                                Margin="6,0,0,8"
                                AutomationProperties.Name="Preview archive operations"
                                AutomationProperties.HelpText="Shows the exact files and destination before an archive command writes anything." />

                      <TextBlock Text="WHEN A FILE EXISTS" Style="{StaticResource SettingsGroupCaption}" />
                      <CheckBox Content="Replace it"
                                IsChecked="{Binding OverwriteArchiveCollisions, Mode=OneWay}"
                                Click="OnArchiveOverwriteSettingClicked"
                                Style="{StaticResource ArchiveToggle}"
                                Margin="6,0,0,8"
                                AutomationProperties.Name="Replace existing archive files"
                                AutomationProperties.HelpText="The original goes to the Recycle Bin before Filekin replaces it." />
                      <TextBlock Margin="6,4,0,0" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource FaintBrush}"
                                 Text="Skip is the safer default. When Replace is on, Filekin sends each original to the Recycle Bin first so the archive operation can be undone during this session." />
                    </StackPanel>

                    <!-- Tidy -->
                    <StackPanel Visibility="{Binding IsTidyCategory, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="BEFORE MOVING" Style="{StaticResource SettingsGroupCaption}" />
                      <CheckBox Content="Show the plan before tidying"
                                IsChecked="{Binding PreviewTidy, Mode=OneWay}"
                                Click="OnTidyPreviewSettingClicked"
                                Style="{StaticResource ArchiveToggle}"
                                Margin="6,0,0,8"
                                AutomationProperties.Name="Preview tidy"
                                AutomationProperties.HelpText="Shows which categories will be created and how many files go into each." />
                      <TextBlock Margin="6,4,0,0" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource FaintBrush}"
                                 Text="/tidy sorts loose files in one folder into Documents, Photos, Audio, Videos, Archives, Installers, and Other. Existing subfolders are left alone, folders of the same name are reused, and a file that is still downloading never moves. Use -y to skip the plan once." />
                    </StackPanel>

                    <!-- Advanced: two separate subjects, kept visibly apart by a rule. -->
                    <StackPanel Visibility="{Binding IsAdvancedCategory, Converter={StaticResource BoolToVis}}">

                      <!-- 1. Filekin's own settings file. -->
                      <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="SETTINGS FILE" Style="{StaticResource SettingsGroupCaption}" />
                        <TextBox Text="{Binding SettingsPath, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="6,0,0,0"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                                 Foreground="{DynamicResource MutedBrush}"
                                 SelectionBrush="{DynamicResource AccentDimBrush}"
                                 AutomationProperties.Name="Settings file path" />
                        <StackPanel Orientation="Horizontal" Margin="6,10,0,0">
                          <Button Content="Open settings.json" Click="OnOpenSettingsFile"
                                  Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                          <Button Content="Show in Files" Click="OnRevealSettingsFolder"
                                  Style="{StaticResource GhostButton}" />
                        </StackPanel>
                        <TextBlock Margin="6,10,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FaintBrush}"
                                   Text="Every setting on these pages lives in this one readable file. It is safe to inspect, edit, copy, and back up. Filekin keeps fields it does not recognise." />
                      </StackPanel>

                      <Border Margin="6,26,0,0" Height="1" Background="{DynamicResource LineBrush}" />

                      <!-- 2. The Windows user PATH, which is not a Filekin setting at all. -->
                      <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="RUN A PROGRAM BY NAME IN A TERMINAL"
                                   Style="{StaticResource SettingsGroupCaption}" />
                        <TextBlock Margin="6,0,0,4" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="These folders are your Windows user PATH variable. When you type a program's name in a terminal, Windows looks through them to find it. Add the folder a program lives in, and you can run it by name from anywhere." />
                        <TextBlock Margin="6,0,0,16" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="This is a real Windows setting for your account, not a Filekin one. It applies to everything you run while signed in as you. Other accounts on this PC are not affected." />

                        <TextBlock Text="Add a folder" Margin="6,0,0,4" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" />
                        <DockPanel Margin="6,0,0,6">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Browse…" Click="OnBrowseUserPath" Style="{StaticResource GhostButton}"
                                    AutomationProperties.Name="Browse for a folder to add" />
                            <Button Content="Add" Click="OnAddUserPath" Style="{StaticResource GhostButton}"
                                    Margin="6,0,0,0" AutomationProperties.Name="Add this folder" />
                          </StackPanel>
                          <TextBox x:Name="NewUserPathBox"
                                   Text="{Binding NewUserPath, UpdateSourceTrigger=PropertyChanged}"
                                   Style="{StaticResource LocationEditorTextBox}"
                                   KeyDown="OnNewUserPathKeyDown"
                                   AutomationProperties.Name="Folder to add"
                                   AutomationProperties.HelpText="Type or paste a folder, or the program file itself. If you only know the program's name, run /where to find it." />
                        </DockPanel>
                        <TextBlock Margin="6,0,0,18" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="Paste the program file itself if that is easier — Filekin adds the folder it sits in. Do not know where it is? Run /where and the program's name, then use Add to PATH beside the result." />

                        <TextBlock Text="Folders in your PATH" Margin="6,0,0,4" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" />
                        <!-- No inner scrollbar: the settings page already scrolls, and two is one too many. -->
                        <ListBox x:Name="UserPathList" ItemsSource="{Binding UserPathRows}"
                                 Style="{StaticResource PlainListBox}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource PathEntryRowItem}"
                                 Button.Click="OnUserPathRowAction"
                                 AutomationProperties.Name="Folders in your Windows user PATH"
                                 AutomationProperties.HelpText="Use Remove on a row to stop Windows searching that folder." />
                        <TextBlock Margin="6,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FaintBrush}"
                                   Text="Nothing here yet. Add a folder above to run its programs by name."
                                   Visibility="{Binding HasNoUserPathRows, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="6,10,0,0">
                          <Button Content="Undo my last change" Click="OnUndoUserPath"
                                  Style="{StaticResource GhostButton}"
                                  AutomationProperties.Name="Undo the last change to your PATH"
                                  Visibility="{Binding CanUndoUserPathChange, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>

                    <Border Margin="6,16,0,6" Padding="0"
                            Visibility="{Binding HasSettingsMessage, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding SettingsMessage}" FontFamily="{DynamicResource MonoFont}"
                                 FontSize="12.5" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding SettingsMessageIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Grid>

      <!-- A terminal tab replaces the entire Files workspace; its shell context is independent. -->
      <ContentControl Grid.Row="1" Content="{Binding SelectedTerminal}"
                      Visibility="{Binding IsTerminalWorkspaceSelected, Converter={StaticResource BoolToVis}}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:TerminalControl x:Name="TerminalSurface" Session="{Binding}" />
              <ScrollBar Grid.Column="1" Orientation="Vertical" Margin="0,6" Minimum="0"
                         Maximum="{Binding ScrollMaximum, ElementName=TerminalSurface}"
                         Value="{Binding ScrollValue, ElementName=TerminalSurface, Mode=TwoWay}"
                         ViewportSize="{Binding ViewportLines, ElementName=TerminalSurface}"
                         LargeChange="{Binding ViewportLines, ElementName=TerminalSurface}"
                         SmallChange="1" AutomationProperties.Name="Terminal scrollback">
                <ScrollBar.Style>
                  <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ScrollMaximum, ElementName=TerminalSurface}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollBar.Style>
              </ScrollBar>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- One reusable in-app confirmation for a live tab or consolidated application shutdown. -->
      <Grid x:Name="TerminalConfirmationOverlay" Grid.Row="1" Background="{DynamicResource ScrimBrush}"
            Visibility="Collapsed">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="22,18"
                Background="{DynamicResource ElevateBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="TerminalConfirmationText" Foreground="{DynamicResource TextBrush}"
                       FontFamily="{DynamicResource MonoFont}" FontSize="13" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="TerminalConfirmYesButton" Content="Y · Yes" Click="OnTerminalConfirmYes"
                      Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
              <Button Content="N · No" Click="OnTerminalConfirmNo" Style="{StaticResource GhostButton}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ================= STATUS BAR ================= -->
      <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Ready" Margin="8,0,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Visibility="{Binding IsFilesWorkspaceSelected, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding WorkspaceSelectionStatus}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
            <TextBlock Text="{Binding StatusFree}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                       Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Interactive terminal · Ctrl+Shift+V paste" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontFamily="{DynamicResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                     Visibility="{Binding IsTerminalWorkspaceSelected, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
